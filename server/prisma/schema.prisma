generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  TRAINER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  ABS
  CARDIO
  FULL_BODY
}

enum TrainerSpecialization {
  STRENGTH
  BODYBUILDING
  WEIGHT_LOSS
  CROSSFIT
  YOGA
  CARDIO
  POWERLIFTING
  FUNCTIONAL
  GENERAL_FITNESS
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  ONLINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ClassBookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
}

enum NotificationType {
  MEMBERSHIP
  PAYMENT
  DIET
  WORKOUT
  CLASS
  GENERAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum CheckInMethod {
  MANUAL
  QR_CODE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE    // e.g. 20% off
  FIXED_AMOUNT  // e.g. ₹500 off
  FREE_DAYS     // e.g. 15 extra days added to membership
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum TrainerType {
  COMMON
  PERSONAL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member              Member?
  trainer             Trainer?
  notifications       Notification[]
  trainerApplications TrainerApplication[]
}

model Member {
  id                    String    @id @default(cuid())
  userId                String    @unique
  firstName             String
  lastName              String
  phone                 String    @unique
  gender                Gender
  dob                   DateTime?
  address               String?
  height                Float?
  weight                Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  trainerId             String?
  joinedAt              DateTime  @default(now())

  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer             Trainer?           @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  attendances         Attendance[]
  workoutAssignments  WorkoutAssignment[]
  dietAssignments     DietAssignment[]
  progressLogs        ProgressLog[]
  payments            Payment[]
  classBookings       ClassBooking[]
  complaints          Complaint[]

  // ─── Coupon & Referral Relations ───────────────────
  couponUsages        CouponUsage[]
  referralLink        ReferralLink?
  referredBy          Referral?     @relation("ReferredMember")
  trainerRatings      TrainerRating[]
}

model Trainer {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  firstName       String
  lastName        String
  phone           String                 @unique
  gender          Gender
  specialization  TrainerSpecialization  @default(GENERAL_FITNESS)
  specializations TrainerSpecialization[] @default([GENERAL_FITNESS])
  experience      Int?
  salary          Decimal?
  bio             String?
  trainerType     TrainerType            @default(PERSONAL)
  profilePhoto    String?
  certifications  String[]               @default([])
  averageRating   Float                  @default(0.0)
  totalReviews    Int                    @default(0)
  joinedAt        DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  members            Member[]
  workoutAssignments WorkoutAssignment[]
  workoutPlans       WorkoutPlan[]
  dietAssignments    DietAssignment[]
  dietPlans          DietPlan[]
  gymClasses         GymClass[]
  schedules          TrainerSchedule[]
  timeOffs           TrainerTimeOff[]
  trainerRatings     TrainerRating[]
}

model TrainerApplication {
  id              String                @id @default(cuid())
  userId          String
  specialization  TrainerSpecialization @default(GENERAL_FITNESS)
  specializations TrainerSpecialization[] @default([GENERAL_FITNESS])
  experience      Int?
  bio             String?
  certifications  String[]              @default([])
  coverNote       String?

  status          ApplicationStatus     @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MembershipPlan {
  id             String   @id @default(cuid())
  name           String   @unique
  durationMonths Int
  price          Decimal
  description    String?
  isActive       Boolean  @default(true)
  providedTrainerType TrainerType @default(COMMON)

  memberships Membership[]
}

model Membership {
  id        String           @id @default(cuid())
  memberId  String
  planId    String
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  // ─── Freeze / Pause ──────────────────────────
  frozenAt           DateTime?
  freezeDurationDays Int?
  freezeReason       String?
  freezeCount        Int       @default(0)

  // ─── Coupon ───────────────────────────────────
  couponId    String?

  member      Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]
  couponUsage CouponUsage?
}

model Attendance {
  id            String        @id @default(cuid())
  memberId      String
  checkIn       DateTime      @default(now())
  checkOut      DateTime?
  date          DateTime      @default(now()) @db.Date
  checkInMethod CheckInMethod @default(MANUAL)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Exercise {
  id          String             @id @default(cuid())
  name        String             @unique
  muscleGroup MuscleGroup
  description String
  difficulty  ExerciseDifficulty?
  videoUrl    String?

  workoutAssignments     WorkoutAssignment[]
  workoutPlanExercises   WorkoutPlanExercise[]
}

model WorkoutAssignment {
  id             String   @id @default(cuid())
  memberId       String
  trainerId      String
  exerciseId     String
  workoutPlanId  String?
  sets           Int
  reps           Int
  weight         Float?
  restSeconds    Int?
  assignedDate   DateTime @default(now())

  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer      Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutPlan  WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
}

model DietPlan {
  id           String  @id @default(cuid())
  trainerId    String
  title        String
  description  String?
  calories     Int?
  protein      Float?
  carbs        Float?
  fats         Float?
  durationDays Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trainer         Trainer          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dietAssignments DietAssignment[]
}

model DietAssignment {
  id         String   @id @default(cuid())
  memberId   String
  trainerId  String
  dietPlanId String
  assignedAt DateTime @default(now())
  endDate    DateTime?
  durationDays Int?

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer  Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Restrict)
}

model ProgressLog {
  id         String   @id @default(cuid())
  memberId   String
  weight     Float?
  chest      Float?
  waist      Float?
  arms       Float?
  thigh      Float?
  notes      String?
  recordedAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  memberId      String
  membershipId  String?
  amount        Decimal
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paidAt        DateTime      @default(now())
  description   String?

  // ─── Razorpay Gateway Fields ──────────────────────────
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?

  // ─── Refund Tracking ─────────────────────────────────
  refundId       String?   @unique
  refundedAmount Decimal?
  refundReason   String?
  refundedAt     DateTime?

  // ─── Invoice ─────────────────────────────────────────
  invoiceNumber  String?   @unique

  // ─── Coupon Usage ─────────────────────────────────
  appliedCouponCode String?
  couponUsageId  String?   @unique

  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership   Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  couponUsage  CouponUsage? @relation(fields: [couponUsageId], references: [id], onDelete: SetNull)
}

model GymClass {
  id          String   @id @default(cuid())
  trainerId   String
  title       String
  description String?
  capacity    Int
  startTime   DateTime
  endTime     DateTime

  trainer  Trainer        @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  bookings ClassBooking[]
}

model ClassBooking {
  id       String             @id @default(cuid())
  classId  String
  memberId String
  bookedAt DateTime           @default(now())
  status   ClassBookingStatus @default(BOOKED)

  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ─── Workout Plan Models ─────────────────────────────────────────────────────

model WorkoutPlan {
  id          String   @id @default(cuid())
  trainerId   String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer     Trainer              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  exercises   WorkoutPlanExercise[]
  assignments WorkoutAssignment[]
}

model WorkoutPlanExercise {
  id            String  @id @default(cuid())
  workoutPlanId String
  exerciseId    String
  sets          Int
  reps          Int
  weight        Float?
  restSeconds   Int?
  orderIndex    Int     @default(0)

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
}

// ─── Trainer Schedule ────────────────────────────────────────────────────────

model TrainerSchedule {
  id          String  @id @default(cuid())
  trainerId   String
  dayOfWeek   Int                 // 0=Sun, 1=Mon, ..., 6=Sat
  startTime   String              // "09:00"
  endTime     String              // "17:00"
  isAvailable Boolean @default(true)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model TrainerTimeOff {
  id          String   @id @default(cuid())
  trainerId   String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  isFullDay   Boolean  @default(true)
  createdAt   DateTime @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  @@index([trainerId, startDate, endDate])
}

// ─── Optional Models ─────────────────────────────────────────────────────────

model Equipment {
  id              String          @id @default(cuid())
  name            String          @unique
  category        String
  quantity        Int
  purchaseDate    DateTime?
  maintenanceDate DateTime?
  status          EquipmentStatus @default(AVAILABLE)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String          @id @default(cuid())
  memberId    String
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime        @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model TrainerRating {
  id        String   @id @default(cuid())
  memberId  String
  trainerId String
  rating    Int      // 1-5 stars
  comment   String?
  weekStart DateTime // Start of the rating week (Monday)
  createdAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([memberId, trainerId, weekStart])
  @@index([trainerId])
}

// ─── Coupon & Referral Models ─────────────────────────────────────────────────

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  description        String?
  discountType       DiscountType
  discountValue      Decimal
  minPurchaseAmount  Decimal?     // Minimum order amount for coupon to apply
  maxDiscountAmount  Decimal?     // Cap for PERCENTAGE discounts
  maxUsageCount      Int?         // null = unlimited
  usageCount         Int          @default(0)
  perUserLimit       Int          @default(1) // Times a single user can use it
  applicablePlanIds  String[]     @default([]) // Empty array = applicable to all plans
  isReferral         Boolean      @default(false) // System-generated referral coupon
  startDate          DateTime     @default(now())
  expiresAt          DateTime?
  status             CouponStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  usages    CouponUsage[]
  referrals Referral[]    @relation("RefereeCoupon")

  @@index([code])
  @@index([status])
  @@index([expiresAt])
}

model CouponUsage {
  id               String   @id @default(cuid())
  couponId         String
  memberId         String
  membershipId     String?  @unique // One coupon usage per membership
  discountApplied  Decimal  // Actual INR amount saved
  extraDaysGranted Int?     // For FREE_DAYS coupon type
  usedAt           DateTime @default(now())

  coupon     Coupon      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  payment    Payment?

  @@index([couponId])
  @@index([memberId])
}

model ReferralLink {
  id                   String   @id @default(cuid())
  memberId             String   @unique
  code                 String   @unique
  totalReferrals       Int      @default(0)
  successfulReferrals  Int      @default(0)
  createdAt            DateTime @default(now())

  member    Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([code])
}

model Referral {
  id                     String    @id @default(cuid())
  referralLinkId         String
  referredMemberId       String    @unique
  referrerRewardGranted  Boolean   @default(false)
  refereeRewardGranted   Boolean   @default(false)
  referrerMembershipId   String?   // Which membership had days added
  refereeCouponId        String?   // FK → Coupon (auto-created referral coupon for referee)
  rewardGrantedAt        DateTime?
  createdAt              DateTime  @default(now())

  referralLink    ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  referredMember  Member       @relation("ReferredMember", fields: [referredMemberId], references: [id], onDelete: Cascade)
  refereeCoupon   Coupon?      @relation("RefereeCoupon", fields: [refereeCouponId], references: [id], onDelete: SetNull)

  @@index([referralLinkId])
  @@index([referredMemberId])
}